{
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1"
  },
  "fmt": {
    "lineWidth": 120
  },
  "tasks": {
    "dev": "deno run --allow-env=HOME --allow-read --allow-write --allow-net --allow-run=/bin/sh src/cli.ts",
    "compile": "deno compile --allow-all -o apw src/cli.ts",
    "compile:x86_64": "deno compile --allow-all --target x86_64-apple-darwin -o dist/apw-x86_64-apple-darwin src/cli.ts",
    "compile:aarch64": "deno compile --allow-all --target aarch64-apple-darwin -o dist/apw-aarch64-apple-darwin src/cli.ts"
  }
}
